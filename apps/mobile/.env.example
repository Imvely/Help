# 복사해서 .env 로 쓰세요 (Expo 는 EXPO_PUBLIC_ 접두사 변수만 앱 번들에 넣습니다 — 공개돼도 되는 값만!).
EXPO_PUBLIC_API_URL=http://localhost:8000/v1
# Supabase 대시보드 → Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# "anon public" (새 대시보드에서는 "Publishable key", sb_publishable_... 도 동일하게 사용 가능)
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# 목업 로그인(개발 전용). 서버 EODISAN_AUTH_MOCK=1 과 함께 켠다
EXPO_PUBLIC_AUTH_MOCK=0
