# 복사해서 .env 로 쓰세요. 접두사 EODISAN_ 이 붙습니다.
# 로컬 개발(외부 의존 없음)은 SQLite. docker compose 를 쓰면 아래 Postgres 줄로 바꾼다.
EODISAN_DATABASE_URL=sqlite:///./data/eodisan.db
# EODISAN_DATABASE_URL=postgresql+psycopg://eodisan:eodisan@localhost:5432/eodisan
EODISAN_REDIS_URL=redis://localhost:6379/0
# 식약처 식품안전나라 OpenAPI 인증키 (https://www.foodsafetykorea.go.kr/apiMain.do)
EODISAN_MFDS_API_KEY=
# 이미지 인식 모델(선택). 비우면 /recognize 는 501
EODISAN_EMBEDDER_ONNX_PATH=
EODISAN_EMBEDDING_MODEL_VERSION=dinov3-vits16-v0

# ── M2 라벨 OCR ──
# Claude 구조화 추출(이미지+OCR 텍스트 → JSON). anthropic SDK 가 읽는 표준 변수
ANTHROPIC_API_KEY=
EODISAN_LABEL_EXTRACTION_ENABLED=1
EODISAN_LABEL_EXTRACTION_MODEL=claude-opus-5-5
# PaddleOCR(PP-OCRv5 korean) 사용 여부. uv pip install -e ".[ocr]" 후 1
EODISAN_OCR_USE_PADDLE=0
# dev: 요청 안에서 바로 처리(1). prod: 워커(python -m app.pipeline.ocr_worker)가 처리(0)
EODISAN_OCR_INLINE=1
EODISAN_UPLOAD_DIR=./data/uploads
# 같은 라벨 제보가 n명 일치하면 '검증됨'
EODISAN_LABEL_VERIFY_THRESHOLD=3

# ── M3 로그인·프로필 동기화·푸시 ──
# Supabase: 프로젝트 URL 만 있으면 공개 JWKS 로 검증(권장). 대시보드 → Project Settings → API → Project URL
EODISAN_SUPABASE_URL=
# 목업 로그인(개발 전용, 운영 0): POST /v1/auth/mock/token 으로 토큰 발급
EODISAN_AUTH_MOCK=0
# (선택) 레거시 HS256 방식을 쓸 때만: Project Settings → API → JWT Keys → Legacy JWT Secret
EODISAN_SUPABASE_JWT_SECRET=
# 프로필 암호화 키: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EODISAN_PROFILE_ENCRYPTION_KEY=
# Expo 푸시 (선택: Expo 대시보드 access token)
EODISAN_EXPO_ACCESS_TOKEN=
