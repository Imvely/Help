# 복사해서 .env 로 쓰세요. 접두사 EODISAN_ 이 붙습니다.
EODISAN_DATABASE_URL=postgresql+psycopg://eodisan:eodisan@localhost:5432/eodisan
EODISAN_REDIS_URL=redis://localhost:6379/0
# 식약처 식품안전나라 OpenAPI 인증키 (https://www.foodsafetykorea.go.kr/apiMain.do)
EODISAN_MFDS_API_KEY=
# 이미지 인식 모델(선택). 비우면 /recognize 는 501
EODISAN_EMBEDDER_ONNX_PATH=
EODISAN_EMBEDDING_MODEL_VERSION=dinov3-vits16-v0
